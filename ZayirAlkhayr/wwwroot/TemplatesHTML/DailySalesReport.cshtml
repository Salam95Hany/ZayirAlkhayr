@model ZayirAlkhayr.Reports.Model.DailySalesPdfModel

@{
    var textAlign = Model.IsRightToLeft ? "right" : "left";
}

<div dir="rtl" style="font-family:'Cairo'; color:#1f2937; padding:18px;">
    <div style="border-bottom:2px solid #0f766e; padding-bottom:12px; margin-bottom:18px;">
        <div style="font-size:26px; font-weight:700; color:#0f172a;">@Model.Title</div>
        <div style="margin-top:8px; font-size:12px; color:#475569;">
            <span>تاريخ التوليد: @Model.GeneratedAt</span>
            <span style="margin-inline-start:18px;">بواسطة: @Model.GeneratedBy</span>
        </div>
    </div>

    @if (Model.SummaryItems != null && Model.SummaryItems.Count > 0)
    {
        <div style="margin-bottom:18px;">
            <div style="font-size:16px; font-weight:700; margin-bottom:10px; color:#0f172a;">الملخص التنفيذي</div>
            <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate; border-spacing:10px;">
                <tr>
                    @foreach (var item in Model.SummaryItems)
                    {
                        <td style="width:33%; vertical-align:top;">
                            <div style="border:1px solid #cbd5e1; border-radius:10px; padding:12px; background:#f8fafc;">
                                <div style="font-size:11px; color:#64748b; margin-bottom:6px;">@item.Label</div>
                                <div style="font-size:16px; font-weight:700; color:#0f172a;">@item.Value</div>
                            </div>
                        </td>
                    }
                </tr>
            </table>
        </div>
    }

    @if (Model.AppliedFilters != null && Model.AppliedFilters.Count > 0)
    {
        <div style="margin-bottom:18px;">
            <div style="font-size:16px; font-weight:700; margin-bottom:10px; color:#0f172a;">الفلاتر المطبقة</div>
            <table width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse; border:1px solid #e2e8f0;">
                @foreach (var filter in Model.AppliedFilters)
                {
                    <tr>
                        <td style="width:28%; background:#f8fafc; border-bottom:1px solid #e2e8f0; font-weight:700;">@filter.Label</td>
                        <td style="border-bottom:1px solid #e2e8f0;">@filter.Value</td>
                    </tr>
                }
            </table>
        </div>
    }

    <div>
        <div style="font-size:16px; font-weight:700; margin-bottom:10px; color:#0f172a;">معاينة البيانات</div>

        @if (!string.IsNullOrWhiteSpace(Model.PreviewNotice))
        {
            <div style="margin-bottom:10px; padding:10px 12px; border-radius:8px; background:#fff7ed; color:#9a3412; font-size:12px;">
                @Model.PreviewNotice
            </div>
        }

        @if (Model.DetailHeaders != null && Model.DetailHeaders.Count > 0)
        {
            <table width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse; table-layout:fixed; font-size:11px;">
                <thead>
                    <tr style="background:#0f766e; color:#ffffff; text-align:@textAlign;">
                        @foreach (var header in Model.DetailHeaders)
                        {
                            <th style="border:1px solid #d1d5db;">@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.DetailRows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td style="border:1px solid #e5e7eb; word-wrap:break-word;">@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding:18px; border:1px dashed #cbd5e1; border-radius:10px; color:#64748b;">
                لا توجد بيانات متاحة للعرض.
            </div>
        }
    </div>
</div>
